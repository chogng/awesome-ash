load("//:defs.bzl", "ash_rust_binary", "ash_rust_crate")

ash_rust_crate(
    name = "app-server-protocol",
    crate_name = "ash_app_server_protocol",
    crate_features = ["export", "json-schema"],
    # Bazel derives the handshake hash from Rust; no local Cargo output is an input.
    extra_deps = ["@crates//:schemars", "@crates//:sha2"],
)

ash_rust_binary(
    name = "generate_protocol",
    crate_name = "generate_protocol",
    crate_root = "src/bin/generate_protocol.rs",
    deps = [":app-server-protocol"],
)
